{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Build Example_1",
            "type": "shell",
            "command": "make -C ${workspaceFolder}/Example_1",
            "group": "build"
        },
        {
            "label": "2. Deploy Example_1",
            "type": "shell",
            "command": "scp ${workspaceFolder}/Example_1/bin/rbp pi@192.168.137.3:/home/pi/RBP/Example_1/bin ; ssh pi@192.168.137.3 'chmod +x /home/pi/RBP/Example_1/bin/rbp'",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "3. DBGServer Example_1",
            "type": "shell",
            "command": "ssh pi@192.168.137.3 'pkill gdbserver; cd /home/pi/RBP/Example_1/bin; gdbserver :2345 ./rbp'",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "FULL: Build + Deploy + DBGServer Example_1",
            "dependsOn": [
                "1. Build Example_1",
                "2. Deploy Example_1",
                "3. DBGServer Example_1"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "build"
        }
    ]
}